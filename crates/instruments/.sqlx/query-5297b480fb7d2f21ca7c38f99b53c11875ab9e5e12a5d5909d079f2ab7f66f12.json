  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n               m.id,\n               m.market_index,\n               m.is_active,\n               m.tick_size,\n               m.lot_size,\n               m.min_notional,\n               m.price_scale,\n               m.qty_scale,\n               base.name  AS base,\n               quote.name AS quote\n            FROM markets m\n            JOIN assets base  ON base.id  = m.base_asset_id\n            JOIN assets quote ON quote.id = m.quote_asset_id \n            ",
